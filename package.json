{
  "name": "foveastream",
  "version": "1.1.0",
  "description": "無邊框四視窗串流播放器 (Streamlink + 多核心硬體加速架構)",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:smoke": "electron tests/electron.smoke.js",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir"
  },
  "build": {
    "appId": "com.foveastream.app",
    "productName": "FoveaStream",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "extraResources": [
      {
        "from": "streamlink-plugins",
        "to": "streamlink-plugins",
        "filter": [
          "*.py"
        ]
      },
      {
        "from": "resources/bin/streamlink",
        "to": "bin/streamlink",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "keywords": [
    "streamlink",
    "vlc",
    "multiview",
    "quad-stream",
    "borderless"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "hls.js": "^1.5.20",
    "mpegts.js": "^1.8.2"
  },
  "devDependencies": {
    "electron": "^41.0.1",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true
  }
}
