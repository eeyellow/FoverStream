{
  "name": "foveastream",
  "version": "1.0.0",
  "description": "無邊框四視窗串流播放器 (VLC + Streamlink 架構)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir"
  },
  "build": {
    "appId": "com.foveastream.app",
    "productName": "FoveaStream",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "extraResources": [
      {
        "from": "resources/bin/streamlink",
        "to": "bin/streamlink",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "keywords": [
    "streamlink",
    "vlc",
    "multiview",
    "quad-stream",
    "borderless"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "hls.js": "^1.5.20",
    "mpegts.js": "^1.8.2"
  },
  "devDependencies": {
    "electron": "^41.0.1",
    "electron-builder": "^26.15.3"
  }
}
